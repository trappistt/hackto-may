APP_NAME=hackto-may

# API server (backend/src/index.js)
API_PORT=3001
API_BASE_URL=http://localhost:3001
# Comma-separated UI origins (no trailing slash). Example production + local:
# FRONTEND_ORIGIN=http://localhost:5173,https://hackto-may.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
# Allow any https://*.vercel.app preview deployment (hackathon / PR previews)
CORS_ALLOW_VERCEL_PREVIEWS=true

# Persistence (Phase 1)
DATABASE_PATH=./backend/data/app.db

# Backboard (Phase 1b)
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=

# ElevenLabs (Phase 3)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Optional: require on ConvAI webhook POSTs to /api/webhooks/elevenlabs/tools/*
ELEVENLABS_WEBHOOK_SECRET=

# Frontend — spoken ConvAI agent (public agent id; lives in repo-root .env with other keys)
# VITE_ELEVENLABS_AGENT_ID=agent_xxxxxxxx
