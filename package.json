{
  "name": "hackto-may",
  "version": "0.1.0",
  "private": true,
  "description": "Proactive financial copilot — interest black hole scanner + coach API.",
  "type": "module",
  "scripts": {
    "dev": "node backend/src/index.js",
    "dev:api": "node backend/src/index.js",
    "dev:web": "npm run dev --prefix frontend",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "start": "node backend/src/index.js",
    "build:web": "npm run build --prefix frontend",
    "test": "node --test backend/src/**/*.test.js",
    "backboard:check": "node backend/scripts/check-backboard.js",
    "elevenlabs:check": "node backend/scripts/check-elevenlabs.js",
    "eval": "node backend/scripts/run-eval.js",
    "eval:local": "node backend/scripts/run-eval.js --skip-coach"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "yaml": "^2.8.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0"
  },
  "keywords": [
    "hackathon",
    "fintech",
    "ai-agent"
  ],
  "license": "MIT"
}
